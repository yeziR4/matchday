# Copy this file to .env. Keep secrets out of chat and source control.
PORT=3000
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:3000
# demo uses fictional fixtures; live requires FOOTBALL_DATA_TOKEN.
DATA_MODE=demo
FOOTBALL_DATA_TOKEN=
DATABASE_PATH=./data/matchday.sqlite
# Enable club crest images only after checking permission for your use.
SHOW_TEAM_CRESTS=false
# Optional. Set to our official project listing after acceptance.
PROJECT_VOTE_URL=
# Optional. Set after deploying contracts/PredictionBook.sol.
PREDICTION_CONTRACT_ADDRESS=
